DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=
DB_NAME=ByGio
DB_PORT=5432
DB_DIALECT=postgres

DB_HOST_GIO=localhost
DB_USER_GIO="recode_DB_Bygio"
DB_PASSWORD_GIO=""
DB_NAME_GIO="recode_DB_Bygio"
DB_PORT_GIO=3306

# Autenticacion. LOS VALORES REALES VAN EN .env.local (NO trackeado) y en
# las Environment Variables de Vercel. Nunca pongas secretos en este archivo.
JWT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Correo remitente para campañas (Gmail). Por defecto: bygionay.88@gmail.com
GOOGLE_MAIL_FROM=bygionay.88@gmail.com

# Ecommerce (valores por defecto; no son secretos)
DTF_PRICE_BASICO=22000
DTF_PRICE_OVERSIZE=32000
# Punto de despacho (Medellin) para calcular la distancia de envio
WAREHOUSE_LAT=6.2442
WAREHOUSE_LNG=-75.5812
# Bloqueo temporal de stock durante el pago (30 min).
# false por defecto: con stock booleano esconde el producto de un carrito
# abandonado. Se activara cuando el stock sea por cantidad.
STOCK_RESERVATION_ENABLED=false

# ---------------------------------------------------------------------------
# Wompi (pagos en linea). PLANTILLA: aqui solo van los nombres de las
# variables. Los valores reales van en Api/.env.local (NO versionado) y en
# las Environment Variables del proyecto en Vercel. Nunca subas llaves al repo.
#
# Con estas variables vacias, POST /api/orders/:id/payment responde 503 y el
# checkout sigue funcionando con el pago manual (transferencia/Nequi).
#
# Sandbox: las llaves empiezan por pub_test_ / prv_test_ y el entorno se
# deduce solo. Para produccion: pub_prod_ / prv_prod_.
# WOMPI_ENV: test | prod (opcional, se deduce de la llave publica)
# ---------------------------------------------------------------------------
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
WOMPI_ENV=
WOMPI_BASE_URL=

# ---------------------------------------------------------------------------
# Endurecimiento HTTP (Fase E). Valores opcionales.
# TRUST_PROXY: saltos de proxy de confianza (Vercel = 1). Vacio = automatico
#              (1 en produccion, apagado en local).
# RATE_LIMIT_ENABLED=false desactiva los limites de peticiones (solo pruebas).
# WOMPI_EVENT_MAX_AGE_SECONDS: eventos mas viejos que esto se registran como
#              "evento_antiguo" (no se descartan: un reintento tardio de Wompi
#              sigue siendo valido). Default 86400.
# ---------------------------------------------------------------------------
TRUST_PROXY=
RATE_LIMIT_ENABLED=true
WOMPI_EVENT_MAX_AGE_SECONDS=86400

GOOGLE_MAIL_CLIENT_ID=
GOOGLE_MAIL_CLIENT_SECRET=